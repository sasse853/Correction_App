APP_NAME="DataCorrection App"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ─── MySQL (Base interne : users, workflow, audit) ───────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=data_correction
DB_USERNAME=root
DB_PASSWORD=

# ─── DB2 (Base cible : destination des corrections validées) ─────────────────
DB2_HOST=your-db2-host
DB2_PORT=50000
DB2_DATABASE=YOUR_DB2_DB
DB2_USERNAME=db2user
DB2_PASSWORD=db2password
DB2_SCHEMA=YOUR_SCHEMA
# DB2_DRIVER peut être "odbc" ou "ibm_db2" selon votre env
DB2_DRIVER=odbc

# ─── Mail ────────────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@datacorrection.local"
MAIL_FROM_NAME="${APP_NAME}"

# ─── Queue (Redis recommandé pour les gros fichiers) ─────────────────────────
QUEUE_CONNECTION=database
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ─── Session & Cache ─────────────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database

# ─── Fichiers uploadés ───────────────────────────────────────────────────────
FILESYSTEM_DISK=local
UPLOAD_MAX_SIZE_MB=20
